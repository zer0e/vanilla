<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.github.zer0e.vanilla.infrastructure.db.mapper.VolumeMapper">

    <select id="selectByStackIdAndName"
            resultType="com.github.zer0e.vanilla.infrastructure.db.repository.VolumeDo">
        select * from t_volume
        <where>
            stack_id = #{stackId}
            and volume_name = #{volumeName}
            and status = 0
        </where>
    </select>
    <select id="selectVolumesByStackIdAndSearch"
            resultType="com.github.zer0e.vanilla.infrastructure.db.repository.VolumeDo">
        select * from t_volume
        <where>
            stack_id = #{stackId}
            <if test="search != null and search != ''">
                and volume_name like concat('%', #{search}, '%')
            </if>
            and status = 0
        </where>
    </select>
</mapper>
