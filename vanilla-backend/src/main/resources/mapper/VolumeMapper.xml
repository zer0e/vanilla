<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.github.zer0e.vanilla.infrastructure.db.mapper.VolumeMapper">

    <select id="selectByServiceIdAndName"
            resultType="com.github.zer0e.vanilla.infrastructure.db.repository.VolumeDo">
        select * from t_volume
        <where>
            service_id = #{serviceId}
            and volume_name = #{volumeName}
            and status = 0
        </where>
    </select>
    <select id="selectVolumesByServiceIdAndSearch"
            resultType="com.github.zer0e.vanilla.infrastructure.db.repository.VolumeDo">
        select * from t_volume
        <where>
            service_id = #{serviceId}
            <if test="search != null and search != ''">
                and volume_name like concat('%', #{search}, '%')
            </if>
            and status = 0
        </where>
    </select>
    <select id="selectVolumesByServiceIds"
            resultType="com.github.zer0e.vanilla.infrastructure.db.repository.VolumeDo">
        select * from t_volume
        <where>
            service_id in
            <foreach collection="serviceIds" item="item" separator="," open="(" close=")">
                #{item}
            </foreach>
            and status = 0
        </where>
    </select>
</mapper>
