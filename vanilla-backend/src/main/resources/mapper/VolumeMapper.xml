<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.github.zer0e.vanilla.infrastructure.db.mapper.VolumeMapper">

    <select id="selectByStackIdAndName"
            resultType="com.github.zer0e.vanilla.infrastructure.db.repository.VolumeDo">
        select * from t_volume
        <where>
            stack_id = #{stackId}
            and volume_name = #{volumeName}
            and status = 0
        </where>
    </select>
    <select id="selectVolumesByStackIdAndSearch"
            resultType="com.github.zer0e.vanilla.infrastructure.db.repository.VolumeDo">
        select * from t_volume
        <where>
            stack_id = #{stackId}
            <if test="search != null and search != ''">
                and volume_name like concat('%', #{search}, '%')
            </if>
            and status = 0
        </where>
        order by id
    </select>
    <select id="selectVolumesByServiceIds"
            resultType="com.github.zer0e.vanilla.infrastructure.db.repository.VolumeDo">
        select v.* from t_volume v
        join t_service_volume sv on sv.volume_id = v.id
        <where>
            sv.service_id in
            <foreach collection="serviceIds" item="item" separator="," open="(" close=")">
                #{item}
            </foreach>
            and v.status = 0
        </where>
        order by v.id
    </select>
</mapper>