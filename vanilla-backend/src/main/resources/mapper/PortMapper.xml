<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.github.zer0e.vanilla.infrastructure.db.mapper.PortMapper">

    <select id="selectByServiceIdAndPort"
            resultType="com.github.zer0e.vanilla.infrastructure.db.repository.PortDo">
        select * from t_port
        <where>
            service_id = #{serviceId}
            and port = #{port}
            and status = 0
        </where>
    </select>
    <select id="selectPortsByServiceId"
            resultType="com.github.zer0e.vanilla.infrastructure.db.repository.PortDo">
        select * from t_port
        <where>
            service_id = #{serviceId}
            and status = 0
        </where>
    </select>
    <select id="selectPortsByServiceIds"
            resultType="com.github.zer0e.vanilla.infrastructure.db.repository.PortDo">
        select * from t_port
        <where>
            <choose>
                <when test="serviceIds != null and serviceIds.size > 0">
                    service_id in
                    <foreach collection="serviceIds" item="item" separator="," open="(" close=")">
                        #{item}
                    </foreach>
                </when>
                <otherwise>
                    1 = 0
                </otherwise>
            </choose>
            and status = 0
        </where>
    </select>
    <select id="selectPortsByStackIdAndSearch"
            resultType="com.github.zer0e.vanilla.infrastructure.db.repository.PortDo">
        select * from t_port
        <where>
            stack_id = #{stackId}
            <if test="search != null and search != ''">
                and port like concat('%', #{search}, '%')
            </if>
            and status = 0
        </where>
        order by id
    </select>
</mapper>
