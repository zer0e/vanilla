<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.github.zer0e.vanilla.infrastructure.db.mapper.RoleMapper">

    <select id="selectRoleIdsByUserId" resultType="com.github.zer0e.vanilla.infrastructure.db.repository.UserRoleDo">
        select * from t_user_role r where r.user_id = #{userId}
    </select>
    <select id="selectPermissionByRoleIds" resultType="java.lang.String">
        select t2.permission_name from t_role_permission t1, t_permission t2
        <where>
            t1.role_id in
            <choose>
                <when test="roleIds != null">
                    <foreach collection="roleIds" item="roleId" separator="," open="(" close=")">
                        #{roleId}
                    </foreach>
                </when>
                <otherwise>
                    ()
                </otherwise>
            </choose>

            AND t1.permission_id = t2.id
        </where>
    </select>
    <select id="selectRoleNameByIds" resultType="java.lang.String">
        select t.role_name from t_role t
        <where>
            t.id in
            <choose>
                <when test="ids != null">
                    <foreach collection="ids" item="id" separator="," open="(" close=")">
                        #{id}
                    </foreach>
                </when>
                <otherwise>
                    ()
                </otherwise>
            </choose>
        </where>
    </select>
    <select id="selectRoleByIds" resultType="com.github.zer0e.vanilla.infrastructure.db.repository.RoleDo">
        select * from t_role
        <where>
            id in
            <choose>
                <when test="ids != null">
                    <foreach collection="ids" item="id" separator="," open="(" close=")">
                        #{id}
                    </foreach>
                </when>
                <otherwise>
                    ()
                </otherwise>
            </choose>
        </where>
    </select>
    <select id="selectRolePermissionByRoleIds"
            resultType="com.github.zer0e.vanilla.infrastructure.db.repository.RolePermissionDo">
        select t1.role_id, t1.permission_id from t_role_permission t1
        <where>
            t1.role_id in
            <choose>
                <when test="roleIds != null">
                    <foreach collection="roleIds" item="roleId" separator="," open="(" close=")">
                        #{roleId}
                    </foreach>
                </when>
                <otherwise>
                    ()
                </otherwise>
            </choose>
        </where>
    </select>
    <select id="selectPermissionByIds"
            resultType="com.github.zer0e.vanilla.infrastructure.db.repository.PermissionDo">
        select * from t_permmission
        <where>
            id in
            <choose>
                <when test="ids != null">
                    <foreach collection="ids" item="id" separator="," open="(" close=")">
                        #{id}
                    </foreach>
                </when>
                <otherwise>
                    ()
                </otherwise>
            </choose>
        </where>
    </select>
</mapper>