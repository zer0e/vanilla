<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.github.zer0e.vanilla.infrastructure.db.mapper.StackMapper">

    <select id="selectByClusterIdAndName"
            resultType="com.github.zer0e.vanilla.infrastructure.db.repository.StackDo">
        <!-- 重名检查：需包含已软删除的行，因为 uk_cluster_stack 唯一索引永久占用栈名 -->
        select * from t_stack
        <where>
            cluster_id = #{clusterId} and
            stack_name = #{stackName}
        </where>
    </select>
    <select id="selectStacksByClusterIdAndStackIds"
            resultType="com.github.zer0e.vanilla.infrastructure.db.repository.StackDo">
        select * from t_stack t
        <where>
            <choose>
                <!-- stackIds 为 null：不过滤（集群管理员/全局管理员看该集群全部栈） -->
                <when test="stackIds == null">
                    1 = 1
                </when>
                <when test="stackIds.size > 0">
                    t.id in
                    <foreach collection="stackIds" item="item" separator="," open="(" close=")">
                       #{item}
                    </foreach>
                </when>
                <otherwise>
                    1 = 0
                </otherwise>
            </choose>
            <if test="search != null and search != ''">
                AND t.stack_name like concat('%', #{search}, '%')
            </if>
            <if test="clusterId != null">
                AND t.cluster_id = #{clusterId}
            </if>
            AND t.status = 0
        </where>
        order by t.id
    </select>
</mapper>