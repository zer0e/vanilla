<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.github.zer0e.vanilla.infrastructure.db.mapper.StackMapper">

    <select id="selectByClusterIdAndName"
            resultType="com.github.zer0e.vanilla.infrastructure.db.repository.StackDo">
        select * from t_stack
        <where>
            cluster_id = #{clusterId} and
            stack_name = #{stackName}
        </where>
    </select>
    <select id="selectStacksByClusterIdAndStackIds"
            resultType="com.github.zer0e.vanilla.infrastructure.db.repository.StackDo">
        select * from t_stack t
        <where>
            <choose>
                <when test="stackIds != null and stackIds.size > 0">
                    t.id in
                    <foreach collection="stackIds" item="item" separator="," open="(" close=")">
                       #{item}
                    </foreach>
                </when>
                <otherwise>
                    1 = 0
                </otherwise>
            </choose>
            <if test="clusterId != null">
                AND t.cluster_id = #{clusterId}
            </if>
        </where>
    </select>
</mapper>