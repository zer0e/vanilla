<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.github.zer0e.vanilla.infrastructure.db.mapper.RolePermissionMapper">
    <select id="selectRolePermissionByRoleIds"
            resultType="com.github.zer0e.vanilla.infrastructure.db.repository.RolePermissionDo">
        select t1.role_id, t1.permission_id from t_role_permission t1
        <where>
            <choose>
                <when test="roleIds != null and roleIds.size > 0">
                    t1.role_id in
                    <foreach collection="roleIds" item="roleId" separator="," open="(" close=")">
                        #{roleId}
                    </foreach>
                </when>
                <otherwise>
                    1 = 0
                </otherwise>
            </choose>
        </where>
    </select>
</mapper>